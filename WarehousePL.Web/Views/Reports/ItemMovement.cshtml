@using WarehouseBLL.BusinessServices.View_Models.Reports
@model ItemMovementViewModel

@{
    ViewBag.Title = "حركة صنف";
}

<form asp-action="ItemMovement" method="get" class="mb-4">
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header  text-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bx bx-filter me-2"></i>بيانات التصفية</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">الصنف</label>
                    <select asp-for="SelectedProductId" asp-items="Model.Products" class="form-select">
                        <option value="">اختر الصنف</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">التاريخ من</label>
                    <input asp-for="DateFrom" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">التاريخ إلى</label>
                    <input asp-for="DateTo" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bx bx-search me-1"></i> عرض
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model != null && Model.SelectedProductId.HasValue && Model.SelectedProductId > 0)
{
    <div class="card shadow-sm border-0">
        <div class="card-header text-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bx bx-transfer me-2"></i>
                حركة الصنف خلال الفترة:
                @if (Model.DateFrom.HasValue && Model.DateTo.HasValue)
                {
                    <span class="fw-normal fs-6 text-light ms-2">
                        (من @Model.DateFrom.Value.ToString("yyyy/MM/dd") إلى @Model.DateTo.Value.ToString("yyyy/MM/dd"))
                    </span>
                }
            </h5>
        </div>
        <div class="card-body">
            <!-- كروت الإحصائيات -->
            <div class="row mb-4 p-3 bg-light rounded border text-center">
                <div class="col-md-4">
                    <span class="d-block text-muted mb-1">إجمالي الداخل (الفترة)</span>
                    <span class="fs-5 fw-bold text-success">@Model.TotalIn.ToString("N2")</span>
                </div>
                <div class="col-md-4">
                    <span class="d-block text-muted mb-1">إجمالي الخارج (الفترة)</span>
                    <span class="fs-5 fw-bold text-danger">@Model.TotalOut.ToString("N2")</span>
                </div>
                <div class="col-md-4">
                    <span class="d-block text-muted mb-1">الرصيد المتبقي التراكمي</span>
                    <span class="fs-5 fw-bold @(Model.NetBalance >= 0 ? "text-primary" : "text-warning")">
                        @Model.NetBalance.ToString("N2")
                    </span>
                </div>
            </div>

            <!-- جدول الحركات -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th width="14%">التاريخ والوقت</th>
                            <th width="12%">نوع العملية</th>
                            <th width="12%">الفرع</th>
                            <th width="12%">المخزن</th>
                            <th>رقم المرجع / الفاتورة</th>
                            <th width="11%" class="text-success">داخل (+)</th>
                            <th width="11%" class="text-danger">خارج (-)</th>
                            <th width="13%">الرصيد المتبقي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HasMovements && Model.Lines != null && Model.Lines.Any())
                        {
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.Date.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <span class="badge @(line.TransactionTypeName == "بيع" ? "bg-danger" :
                                                                                                        line.TransactionTypeName == "شراء" ? "bg-success" : "bg-info")">
                                            @line.TransactionTypeName
                                        </span>
                                    </td>
                                    <td>@line.BranchName</td>
                                    <td>@line.WarehouseName</td>
                                    <td class="fw-semibold">@(string.IsNullOrEmpty(line.ReferenceNumber) ? "-" : line.ReferenceNumber)</td>
                                    <td>
                                        @if (line.InQuantity.HasValue && line.InQuantity.Value > 0)
                                        {
                                            <span class="fw-bold text-success">@line.InQuantity.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (line.OutQuantity.HasValue && line.OutQuantity.Value > 0)
                                        {
                                            <span class="fw-bold text-danger">@line.OutQuantity.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="fw-bold @(line.RunningBalance >= 0 ? "text-primary" : "text-warning")">
                                        @line.RunningBalance.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bx bx-info-circle fs-4 d-block mb-1"></i>
                                    لا توجد أي حركات مخزنية لهذا الصنف خلال الفترة المحددة
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="5" class="text-end">إجمالي حركات الفترة:</td>
                            <td class="text-success">@Model.TotalIn.ToString("N2")</td>
                            <td class="text-danger">@Model.TotalOut.ToString("N2")</td>
                            <td></td>
                        </tr>
                        <tr class="table-dark fw-bold">
                            <td colspan="7" class="text-end">الرصيد التراكمي النهائي:</td>
                            <td class="@(Model.NetBalance >= 0 ? "text-primary" : "text-warning")">
                                @Model.NetBalance.ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}