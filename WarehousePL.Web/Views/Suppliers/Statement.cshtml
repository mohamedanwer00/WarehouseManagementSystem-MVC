@using WarehouseBLL.BusinessServices.View_Models.Supplier
@using WarehouseDAL.Entities.Enums
@model SupplierStatementViewModel

@{
    ViewBag.Title = "كشف حساب مورد";
}

<form asp-action="Statement" method="get" class="mb-4">
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header  text-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bx bx-filter me-2"></i>بيانات التصفية</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">المورد</label>
                    <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select">
                        <option value="">اختر المورد</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">التاريخ من</label>
                    <input asp-for="DateFrom" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">التاريخ إلى</label>
                    <input asp-for="DateTo" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bx bx-search me-1"></i> عرض
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model != null && Model.SupplierId > 0)
{
    <div class="card shadow-sm border-0">
        <div class="card-header text-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bx bx-receipt me-2"></i>
                كشف حساب المورد: @Model.SupplierName
                @if (Model.DateFrom.HasValue && Model.DateTo.HasValue)
                {
                    <span class="fw-normal fs-6 text-light ms-2">
                        (من @Model.DateFrom.Value.ToString("yyyy/MM/dd") إلى @Model.DateTo.Value.ToString("yyyy/MM/dd"))
                    </span>
                }
            </h5>
        </div>
        <div class="card-body">
            <!-- ملخص كشف الحساب -->
            <div class="row mb-4 p-3 bg-light rounded border text-center">
                <div class="col-md-4">
                    <span class="d-block text-muted mb-1">الرصيد الافتتاحي</span>
                    <span class="fs-5 fw-bold text-primary">
                        @Model.OpeningBalance.ToString("N2")
                        (@(Model.OpeningBalanceType == BalanceType.Creditor ? "دائن" : "مدين"))
                    </span>
                </div>
                <div class="col-md-4">
                    <span class="d-block text-muted mb-1">إجمالي الدائن (فواتير/رصيد)</span>
                    <span class="fs-5 fw-bold text-warning">@Model.TotalCreditor.ToString("N2")</span>
                </div>
                <div class="col-md-4">
                    <span class="d-block text-muted mb-1">إجمالي المدين (سدادات)</span>
                    <span class="fs-5 fw-bold text-success">@Model.TotalDebtor.ToString("N2")</span>
                </div>
            </div>

            <!-- جدول المعاملات -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th width="12%">التاريخ</th>
                            <th>البيان / رقم الفاتورة</th>
                            <th width="13%">مدين (سداد)</th>
                            <th width="13%">دائن (علينا)</th>
                            <th width="15%">الرصيد التراكمي</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- سطر الرصيد الافتتاحي -->
                        <tr class="table-secondary">
                            <td>-</td>
                            <td class="text-start fw-bold">رصيد افتتاحي للمورد</td>
                            <td>
                                @if (Model.OpeningBalanceType == BalanceType.Debitor)
                                {
                                    <span class="fw-bold text-success">@Model.OpeningBalance.ToString("N2")</span>
                                }
                            </td>
                            <td>
                                @if (Model.OpeningBalanceType == BalanceType.Creditor)
                                {
                                    <span class="fw-bold text-warning">@Model.OpeningBalance.ToString("N2")</span>
                                }
                            </td>
                            <td class="fw-bold @(Model.OpeningBalanceType == BalanceType.Creditor ? "text-warning" : "text-success")">
                                @((Model.OpeningBalanceType == BalanceType.Creditor ? Model.OpeningBalance : -Model.OpeningBalance).ToString("N2"))
                            </td>
                        </tr>

                        @if (Model.HasTransactions && Model.Lines != null && Model.Lines.Any())
                        {
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.Date.ToString("yyyy/MM/dd")</td>
                                    <td class="text-start">
                                        @if (line.InvoiceId.HasValue && !string.IsNullOrEmpty(line.InvoiceNumber))
                                        {
                                            if (line.IsPurchaseInvoice)
                                            {
                                                <a asp-action="Details" asp-controller="PurchaseInvoices" asp-route-id="@line.InvoiceId.Value" class="text-primary fw-bold text-decoration-none">
                                                    <i class="bx bx-file me-1"></i>فاتورة مشتريات رقم: @line.InvoiceNumber
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            @line.Notes
                                        }
                                    </td>
                                    <td>
                                        @if (line.DebtorAmount.HasValue && line.DebtorAmount.Value > 0)
                                        {
                                            <span class="fw-bold text-success">@line.DebtorAmount.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (line.CreditAmount.HasValue && line.CreditAmount.Value > 0)
                                        {
                                            <span class="fw-bold text-warning">@line.CreditAmount.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="fw-bold @(line.RunningBalance >= 0 ? "text-warning" : "text-success")">
                                        @line.RunningBalance.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bx bx-info-circle fs-4 d-block mb-1"></i>
                                    لا توجد معاملات حركات خاضعة للفترة المحددة
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="2" class="text-end">مجموع الحركة للفترة:</td>
                            <td class="text-success">@Model.TotalDebtor.ToString("N2")</td>
                            <td class="text-warning">@Model.TotalCreditor.ToString("N2")</td>
                            <td></td>
                        </tr>
                        <tr class="table-dark fw-bold">
                            <td colspan="4" class="text-end">الرصيد الختامي المستحق:</td>
                            <td class="@(Model.ClosingBalance >= 0 ? "text-warning" : "text-success")">
                                @Math.Abs(Model.ClosingBalance).ToString("N2")
                                <span class="fs-6 fw-normal">
                                    (@(Model.ClosingBalance >= 0 ? "دائن علينا" : "مدين لدينا"))
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}